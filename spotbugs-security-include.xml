<?xml version="1.0" encoding="UTF-8"?>
<!-- Restricts the SpotBugs gate to security findings (FindSecBugs rules and
     core SECURITY-category detectors) so spotbugs:check acts as a SAST gate
     rather than a general linter. -->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
    <Match>
        <Bug category="SECURITY"/>
    </Match>
    <Match>
        <Bug category="MALICIOUS_CODE"/>
    </Match>
</FindBugsFilter>
